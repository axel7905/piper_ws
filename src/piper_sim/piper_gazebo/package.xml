<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic world and ros2_control configuration for PiPER.</description>
  <maintainer email="axelguevara7905@gmail.com">axelcg_7905</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>ros2action</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
